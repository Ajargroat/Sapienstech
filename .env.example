APP_NAME=Sapienstech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
#
# Leave SESSION_DOMAIN UNSET. Sessions are deliberately host-only so a cookie
# issued to tenant A's domain can never be sent to tenant B. Setting this to a
# shared parent domain (e.g. .sapienstech.test) to "share login across tenants"
# silently breaks that isolation.
# SESSION_DOMAIN=

# Hosts allowed to resolve to the primary tenant instead of 404ing, so
# `php artisan serve` works on localhost without a hosts-file entry per tenant.
# MUST be empty in production: any host listed here gets served whichever
# tenant owns the primary domain.
TENANT_FALLBACK_DOMAINS="localhost,127.0.0.1"

# Extra Host values the Vite dev server should accept. Vite >= 6 rejects
# unknown hosts, which otherwise looks like a 403 on every asset for a new
# tenant. Comma-separated; a leading dot is a subdomain wildcard.
VITE_ALLOWED_HOSTS=".sapienstech.test,.sapienstech.local"
REVERB_APP_ID=1
REVERB_APP_KEY=chatkey
REVERB_APP_SECRET=chatsecret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# AI provider (weekly-planner assistant)
# ---------------------------------------------------------------------------
#
# Two values belong here and only two: the endpoint and the credentials. Both
# are server-side secrets -- the browser never holds either, because every call
# is proxied through the app.
#
# AI_BASE_URL accepts anything speaking the OpenAI /chat/completions shape:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepSeek    https://api.deepseek.com/v1
#   local       http://127.0.0.1:11434/v1   (Ollama; no key needed)
AI_BASE_URL=https://api.openai.com/v1
#
# A comma-separated list, so a key can be rotated (add the new one, deploy,
# remove the old) or a primary/fallback account pair can be run, without a code
# change. Leave EMPTY to run the app without the assistant: the feature reports
# "unconfigured" and the rest of the planner is unaffected.
AI_API_KEYS=
#
# The MODEL is deliberately NOT configured here. It is tenant-resolved config
# (theme.ai.model, overridable per tenant in Settings -> AI assistant), so one
# deploy can serve different models per academy and switching one needs no
# .env edit. AI_MODEL below is only the baseline this deployment ships with.
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_CONNECT_TIMEOUT=8
# How long a provider health probe result is trusted, in seconds.
AI_HEALTH_TTL=60
AI_STREAM=true
# ---------------------------------------------------------------------------
# Supabase question bank (shared pool)
# ---------------------------------------------------------------------------
#
# The exam question bank lives in a Supabase project (Postgres + Storage) and is
# pulled into the local `questions` pool with `php artisan bank:import`. These
# are server-side secrets -- the browser never sees them.
#
#   SUPABASE_URL               https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY  the service_role key (Settings -> API)
#   SUPABASE_BUCKET            the Storage bucket holding the page images
#
# Leave them empty to run without the bank: the importer reports it is
# unconfigured and the rest of the exam feature is unaffected.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=konkour-pages
#
# Some Windows/PHP builds ship without a CA bundle, where every HTTPS call dies
# with "cURL error 60: SSL certificate problem". Set this to false there to
# fall back to the system certificate store. Keep it true in production.
SUPABASE_VERIFY=true
